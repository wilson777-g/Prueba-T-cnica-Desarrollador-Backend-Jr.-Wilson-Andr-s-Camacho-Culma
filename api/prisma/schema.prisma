// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USUARIOS - Autenticación y Autorización
// ============================================
model User {
  id            String      @id @default(cuid())
  email         String      @unique
  nombre        String
  password      String      // Hash bcrypt
  rol           UserRole    @default(OPERADOR)
  sedeId        String?
  sede          Sede?       @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  activo        Boolean     @default(true)
  ultimoLogin   DateTime?
  intentosFallo Int         @default(0)
  bloqueadoHasta DateTime?
  tokenVersion  Int         @default(0)
  mustChangePassword Boolean @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?   // Soft delete
  auditLogs     AuditLog[]

  @@index([email])
  @@index([sedeId])
}

enum UserRole {
  ADMIN
  OPERADOR
}

// ============================================
// SEDES
// ============================================
model Sede {
  id           String      @id @default(cuid())
  nombre       String      @unique
  ciudad       String
  direccion    String
  estado       SedeEstado  @default(ACTIVA)
  usuarios     User[]
  estudiantes  Estudiante[]
  matriculas   Matricula[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([ciudad])
}

enum SedeEstado {
  ACTIVA
  INACTIVA
}

// ============================================
// ESTUDIANTES
// ============================================
model Estudiante {
  id              String              @id @default(cuid())
  nombreCompleto  String
  email           String              @unique
  telefono        String
  documento       String              @unique
  sedeId          String
  sede            Sede                @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  programa        String
  matriculas      Matricula[]
  estado          EstudianteEstado    @default(ACTIVO)
  fechaInscripcion DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?           // Soft delete

  @@index([sedeId])
  @@index([estado])
  @@index([email])
}

model Programa {
  id          String         @id @default(cuid())
  codigo      String         @unique
  nombre      String         @unique
  descripcion String?
  duracionMeses Int
  modalidad   ProgramaModalidad @default(PRESENCIAL)
  estado      ProgramaEstado @default(ACTIVO)
  matriculas  Matricula[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([estado])
}

enum ProgramaModalidad {
  PRESENCIAL
  HIBRIDA
  VIRTUAL
}

enum ProgramaEstado {
  ACTIVO
  INACTIVO
}

model Matricula {
  id            String          @id @default(cuid())
  estudianteId  String
  estudiante    Estudiante      @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  programaId    String
  programa      Programa        @relation(fields: [programaId], references: [id], onDelete: Restrict)
  sedeId        String
  sede          Sede            @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  periodo       String
  estado        MatriculaEstado @default(ACTIVA)
  fechaMatricula DateTime        @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([estudianteId, programaId, periodo])
  @@index([sedeId, periodo])
  @@index([estado])
}

enum MatriculaEstado {
  ACTIVA
  FINALIZADA
  CANCELADA
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  accion     String
  entidad    String
  entidadId  String
  detalle    Json?
  createdAt  DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([userId, createdAt])
}

enum EstudianteEstado {
  ACTIVO
  INACTIVO
  RETIRADO
}
